NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# MongoDB — paste Atlas connection string here
# Example: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/backend-api?retryWrites=true&w=majority
MONGODB_URI=

# Cloudinary — fill these from https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=backend-api
